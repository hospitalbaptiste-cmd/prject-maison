<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Projet Horizon Premium — Volume I</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=IBM+Plex+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --papier:#F2F1EB;
  --papier-creux:#E7E5DB;
  --encre:#131F1A;
  --foret:#1E4034;
  --foret-clair:#3A6B58;
  --eau:#256E7E;
  --eau-clair:#4E97A6;
  --bistre:#8E7134;
  --bistre-clair:#B9A063;
  --lichen:#7B8279;
  --trait:#C9C6B9;
  --trait-fin:#DEDBCE;

  --d:"Fraunces",Georgia,serif;
  --b:"Instrument Sans",-apple-system,Segoe UI,sans-serif;
  --m:"IBM Plex Mono",ui-monospace,monospace;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:#6C6F68;
  font-family:var(--b);
  color:var(--encre);
  -webkit-font-smoothing:antialiased;
  line-height:1.55;
}

/* ---------- PAGE ---------- */
.page{
  position:relative;
  width:210mm;height:297mm;
  margin:10mm auto;
  background:var(--papier);
  padding:20mm 20mm 16mm 24mm;
  overflow:hidden;
  box-shadow:0 4px 24px rgba(0,0,0,.35);
  display:flex;flex-direction:column;
}
.page.sombre{background:var(--foret);color:var(--papier)}
.page.eau{background:var(--eau);color:var(--papier)}

/* ---------- ONGLET ALTITUDE (signature) ---------- */
.onglet{
  position:absolute;left:0;top:0;bottom:0;width:8mm;
  background:var(--papier-creux);
  border-right:.4pt solid var(--trait);
  display:flex;align-items:center;justify-content:center;
}
.onglet span{
  writing-mode:vertical-rl;transform:rotate(180deg);
  font-family:var(--m);font-size:6.5pt;letter-spacing:.22em;
  text-transform:uppercase;color:var(--lichen);
}
.page.sombre .onglet,.page.eau .onglet{background:rgba(255,255,255,.07);border-right-color:rgba(255,255,255,.18)}
.page.sombre .onglet span,.page.eau .onglet span{color:rgba(255,255,255,.55)}

/* ---------- ENTETE / PIED ---------- */
.entete{
  display:flex;justify-content:space-between;align-items:baseline;
  border-bottom:.4pt solid var(--trait);
  padding-bottom:2.5mm;margin-bottom:7mm;
  font-family:var(--m);font-size:7pt;letter-spacing:.14em;text-transform:uppercase;color:var(--lichen);
  flex:0 0 auto;
}
.entete b{font-weight:500;color:var(--foret)}
.pied{
  margin-top:auto;padding-top:3mm;
  border-top:.4pt solid var(--trait);
  display:flex;justify-content:space-between;align-items:center;
  font-family:var(--m);font-size:6.8pt;color:var(--lichen);
  flex:0 0 auto;
}
.pied .nav{display:flex;gap:2.5mm}
.pied .nav a{
  text-decoration:none;color:var(--foret);
  border:.4pt solid var(--trait);border-radius:1mm;
  padding:.8mm 2.2mm;font-size:6.5pt;letter-spacing:.06em;
  background:var(--papier-creux);
}
.pied .nav a:hover{background:var(--foret);color:var(--papier);border-color:var(--foret)}

/* ---------- CORPS ---------- */
.corps{flex:1 1 auto;min-height:0}

/* ---------- TYPO ---------- */
h1{font-family:var(--d);font-weight:600;font-size:34pt;line-height:1.02;letter-spacing:-.02em;font-variation-settings:"SOFT" 0,"WONK" 1}
h2{font-family:var(--d);font-weight:600;font-size:19pt;line-height:1.12;letter-spacing:-.01em;margin-bottom:3mm}
h3{font-family:var(--b);font-weight:600;font-size:10.5pt;letter-spacing:.01em;margin-bottom:1.5mm;color:var(--foret)}
h4{font-family:var(--m);font-weight:500;font-size:7.2pt;letter-spacing:.18em;text-transform:uppercase;color:var(--bistre);margin-bottom:2mm}
p{font-size:9.3pt;line-height:1.62;margin-bottom:3mm;max-width:150mm}
.chapo{font-family:var(--d);font-size:12.5pt;line-height:1.42;font-weight:300;color:var(--foret);margin-bottom:6mm}
.page.sombre .chapo,.page.eau .chapo{color:rgba(255,255,255,.86)}
small{font-size:7.6pt;color:var(--lichen);line-height:1.45}
.mono{font-family:var(--m)}

.eyebrow{
  font-family:var(--m);font-size:7pt;letter-spacing:.24em;text-transform:uppercase;
  color:var(--bistre);margin-bottom:4mm;display:block;
}
.page.sombre .eyebrow,.page.eau .eyebrow{color:var(--bistre-clair)}

/* ---------- LIENS ---------- */
a{color:var(--eau)}
a.lien{
  color:var(--eau);text-decoration:none;
  border-bottom:.4pt solid var(--eau-clair);
}
a.lien:hover{color:var(--foret);border-bottom-color:var(--foret)}

/* ---------- COURBES DE NIVEAU (signature) ---------- */
.courbes{position:absolute;inset:0;pointer-events:none;z-index:0}
.courbes svg{width:100%;height:100%}
.courbes path{fill:none;stroke:var(--bistre);stroke-width:.5;opacity:.13}
.page.sombre .courbes path,.page.eau .courbes path{stroke:#fff;opacity:.12}
.z1{position:relative;z-index:1}

/* ---------- OUVERTURE DE CHAPITRE ---------- */
.ouverture{justify-content:flex-end}
.ouverture .num{
  font-family:var(--m);font-size:9pt;letter-spacing:.3em;
  color:var(--bistre-clair);margin-bottom:4mm;
}
.ouverture h1{font-size:44pt;color:var(--papier)}
.ouverture .sous{font-family:var(--d);font-size:13pt;font-weight:300;color:rgba(255,255,255,.7);margin-top:5mm;max-width:120mm}
.ouverture .liste{margin-top:9mm;border-top:.4pt solid rgba(255,255,255,.25);padding-top:4mm;
  display:grid;grid-template-columns:1fr 1fr;gap:1.5mm 8mm}
.ouverture .liste div{font-family:var(--m);font-size:7.4pt;color:rgba(255,255,255,.68);letter-spacing:.04em}

/* ---------- SOMMAIRE ---------- */
.toc{border-top:.4pt solid var(--trait)}
.toc a{
  display:flex;align-items:baseline;gap:3mm;
  text-decoration:none;color:var(--encre);
  padding:1.9mm 0;border-bottom:.4pt solid var(--trait-fin);
}
.toc a:hover{color:var(--eau)}
.toc .n{font-family:var(--m);font-size:7pt;color:var(--bistre);width:9mm;flex:0 0 9mm;letter-spacing:.06em}
.toc .t{font-size:9.2pt;font-weight:500}
.toc .pts{flex:1;border-bottom:.4pt dotted var(--trait);transform:translateY(-1mm)}
.toc .pg{font-family:var(--m);font-size:7.4pt;color:var(--lichen)}
.toc .sub .t{font-weight:400;font-size:8.5pt;padding-left:6mm;color:#3d4a44}
.toc-groupe{
  font-family:var(--m);font-size:7pt;letter-spacing:.2em;text-transform:uppercase;
  color:var(--bistre);margin:6mm 0 2mm;padding-bottom:1mm;border-bottom:.6pt solid var(--bistre-clair);
}

/* ---------- RESSOURCES ---------- */
.res-bloc{margin-bottom:5mm;break-inside:avoid}
.res-titre{
  display:flex;align-items:center;gap:2mm;
  font-family:var(--b);font-weight:600;font-size:9.5pt;color:var(--foret);
  padding-bottom:1.2mm;margin-bottom:2mm;border-bottom:.6pt solid var(--foret-clair);
}
.res-sous{font-family:var(--m);font-size:6.8pt;letter-spacing:.16em;text-transform:uppercase;color:var(--bistre);margin:2.5mm 0 1.5mm}
.res-grille{display:grid;grid-template-columns:1fr 1fr;gap:.6mm 6mm}
.res-grille.trois{grid-template-columns:1fr 1fr 1fr}
.res-item{
  display:flex;justify-content:space-between;align-items:baseline;gap:2mm;
  font-size:8pt;padding:.7mm 0;border-bottom:.4pt solid var(--trait-fin);
  text-decoration:none;color:var(--encre);
}
.res-item:hover{color:var(--eau)}
.res-item .nom{font-weight:500}
.res-item .url{font-family:var(--m);font-size:6.2pt;color:var(--lichen);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:38mm}
.res-item:hover .url{color:var(--eau-clair)}

/* ---------- TABLEAUX ---------- */
table{width:100%;border-collapse:collapse;font-size:8.2pt;margin-bottom:4mm}
th{
  font-family:var(--m);font-size:6.8pt;letter-spacing:.14em;text-transform:uppercase;
  color:var(--bistre);text-align:left;padding:1.8mm 2mm;
  border-bottom:.8pt solid var(--foret-clair);font-weight:500;
}
td{padding:1.8mm 2mm;border-bottom:.4pt solid var(--trait-fin);vertical-align:top}
tr:hover td{background:rgba(37,110,126,.05)}
td.num{font-family:var(--m);font-size:7.6pt;color:var(--foret);white-space:nowrap}
.vide{color:var(--trait);font-family:var(--m);font-size:7.4pt;letter-spacing:.1em}

/* ---------- ENCADRES ---------- */
.encadre{
  background:var(--papier-creux);
  border-left:1.2mm solid var(--eau);
  padding:4mm 5mm;margin:4mm 0;break-inside:avoid;
}
.encadre.bistre{border-left-color:var(--bistre)}
.encadre.foret{border-left-color:var(--foret-clair)}
.encadre h4{margin-bottom:1.5mm}
.encadre p{font-size:8.6pt;margin-bottom:1.5mm;max-width:none}
.encadre p:last-child{margin-bottom:0}

/* ---------- FICHES / CARTES ---------- */
.duo{display:grid;grid-template-columns:1fr 1fr;gap:6mm}
.trio{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5mm}
.quatuor{display:grid;grid-template-columns:repeat(4,1fr);gap:4mm}

.slot{
  border:.5pt dashed var(--trait);
  background:repeating-linear-gradient(45deg,transparent,transparent 4px,rgba(201,198,185,.18) 4px,rgba(201,198,185,.18) 8px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  color:var(--lichen);font-family:var(--m);font-size:6.8pt;letter-spacing:.14em;text-transform:uppercase;
  text-align:center;padding:3mm;gap:1.5mm;
}
.slot .ic{font-size:13pt;opacity:.45;letter-spacing:0}

.fiche{border:.5pt solid var(--trait);background:#fff;padding:0;break-inside:avoid}
.fiche-tete{background:var(--foret);color:var(--papier);padding:2.2mm 3mm;display:flex;justify-content:space-between;align-items:center}
.fiche-tete .t{font-family:var(--b);font-weight:600;font-size:8.6pt}
.fiche-tete .r{font-family:var(--m);font-size:6.6pt;letter-spacing:.12em;opacity:.7}
.fiche-corps{padding:3mm}
.ligne{display:flex;justify-content:space-between;gap:3mm;font-size:7.8pt;padding:1.1mm 0;border-bottom:.4pt solid var(--trait-fin)}
.ligne:last-child{border-bottom:0}
.ligne .k{color:var(--lichen);font-family:var(--m);font-size:6.6pt;letter-spacing:.1em;text-transform:uppercase;padding-top:.4mm}
.ligne .v{font-weight:500;text-align:right}

.bouton{
  display:inline-block;background:var(--eau);color:#fff;text-decoration:none;
  font-family:var(--m);font-size:6.8pt;letter-spacing:.14em;text-transform:uppercase;
  padding:1.6mm 3.5mm;border-radius:.8mm;margin-right:1.5mm;margin-top:1mm;
}
.bouton.creux{background:transparent;color:var(--eau);border:.5pt solid var(--eau)}
.bouton:hover{background:var(--foret);color:#fff;border-color:var(--foret)}

/* ---------- SCORE HORIZON ---------- */
.jauge{display:flex;align-items:center;gap:3mm;padding:1.6mm 0;border-bottom:.4pt solid var(--trait-fin)}
.jauge .lab{width:34mm;flex:0 0 34mm;font-size:8.4pt;font-weight:500}
.jauge .barre{flex:1;height:2.6mm;background:var(--papier-creux);border:.4pt solid var(--trait);position:relative;overflow:hidden}
.jauge .barre i{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,var(--foret-clair),var(--eau));display:block}
.jauge .val{width:12mm;flex:0 0 12mm;text-align:right;font-family:var(--m);font-size:7.6pt;color:var(--foret)}
.jauge .val.attente{color:var(--trait)}

.score-total{
  border:.8pt solid var(--foret);padding:5mm;text-align:center;background:var(--papier-creux);
}
.score-total .n{font-family:var(--d);font-size:46pt;font-weight:600;line-height:1;color:var(--foret)}
.score-total .n.attente{color:var(--trait)}
.score-total .l{font-family:var(--m);font-size:7pt;letter-spacing:.24em;text-transform:uppercase;color:var(--bistre);margin-top:2mm}

.etoiles{font-size:9pt;letter-spacing:.06em;color:var(--bistre)}

/* ---------- COUVERTURE ---------- */
.couv{padding:0;background:var(--foret);color:var(--papier);justify-content:space-between}
.couv-in{position:relative;z-index:2;padding:22mm 20mm;display:flex;flex-direction:column;height:100%}
.couv .marque{font-family:var(--m);font-size:7.4pt;letter-spacing:.36em;text-transform:uppercase;color:var(--bistre-clair)}
.couv h1{font-size:52pt;line-height:.96;margin-top:auto;color:#fff}
.couv .st{font-family:var(--d);font-weight:300;font-size:15pt;color:rgba(255,255,255,.72);margin-top:6mm;max-width:120mm;line-height:1.3}
.couv .meta{margin-top:10mm;padding-top:4mm;border-top:.5pt solid rgba(255,255,255,.3);
  display:flex;gap:12mm;font-family:var(--m);font-size:7pt;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6)}
.couv .meta b{display:block;color:#fff;font-weight:500;margin-top:1mm;font-size:8pt;letter-spacing:.06em}

/* ---------- DIVERS ---------- */
.filet{height:.6pt;background:var(--trait);margin:5mm 0}
.tag{
  display:inline-block;font-family:var(--m);font-size:6.2pt;letter-spacing:.14em;text-transform:uppercase;
  padding:.6mm 1.8mm;border:.4pt solid var(--bistre);color:var(--bistre);border-radius:.6mm;margin-right:1mm;
}
.tag.plein{background:var(--foret);border-color:var(--foret);color:#fff}
.tag.att{border-color:var(--trait);color:var(--lichen)}

ul.puces{list-style:none;margin-bottom:3mm}
ul.puces li{font-size:8.8pt;padding:.9mm 0 .9mm 5mm;position:relative;line-height:1.5}
ul.puces li:before{content:"—";position:absolute;left:0;color:var(--bistre);font-family:var(--m);font-size:7pt;top:1.2mm}

ol.etapes{list-style:none;counter-reset:e}
ol.etapes li{counter-increment:e;font-size:8.8pt;padding:2mm 0 2mm 10mm;position:relative;border-bottom:.4pt solid var(--trait-fin)}
ol.etapes li:before{
  content:counter(e,decimal-leading-zero);position:absolute;left:0;top:2mm;
  font-family:var(--m);font-size:7.4pt;color:var(--bistre);letter-spacing:.1em;
}

/* ---------- IMPRESSION ---------- */
@page{size:A4;margin:0}
@media print{
  body{background:#fff}
  .page{margin:0;box-shadow:none;break-after:page;page-break-after:always}
  .page:last-child{break-after:auto;page-break-after:auto}
  .aide{display:none!important}
  a{text-decoration:none}
}

/* ---------- ECRANS ETROITS ---------- */
@media screen and (max-width:820px){
  .page{width:100%;height:auto;min-height:auto;margin:0 0 6px;padding:18px 16px 14px 30px;box-shadow:none}
  .onglet{width:20px}
  h1{font-size:30pt}.couv h1{font-size:34pt}
  .res-grille,.res-grille.trois,.duo,.trio,.quatuor{grid-template-columns:1fr}
  .res-item .url{max-width:34vw}
  .page.couv{height:auto;min-height:70vh}
  .couv-in{padding:30px 20px}
}

.aide{
  position:fixed;right:12px;bottom:12px;z-index:99;
  background:var(--encre);color:var(--papier);
  font-family:var(--m);font-size:10px;letter-spacing:.08em;
  padding:8px 12px;border-radius:4px;max-width:230px;line-height:1.5;
  box-shadow:0 4px 16px rgba(0,0,0,.4);
}
.aide b{color:var(--bistre-clair)}
</style>
</head>
