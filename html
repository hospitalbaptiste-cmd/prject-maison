<div class="aide"><b>PHASE 1 — MAQUETTE</b><br>Ctrl/Cmd + P → « Enregistrer au format PDF » pour l'export interactif.</div>
<!-- ============ 00 — COUVERTURE ============ -->
<section class="page couv" id="p-couverture">
  <div class="courbes">
    <svg viewBox="0 0 210 297" preserveAspectRatio="none">
      <path d="M-10,250 C40,215 70,240 110,205 S180,180 220,150"/>
      <path d="M-10,262 C40,228 72,252 112,218 S182,193 220,163"/>
      <path d="M-10,274 C40,241 74,264 114,231 S184,206 220,176"/>
      <path d="M-10,286 C40,254 76,276 116,244 S186,219 220,189"/>
      <path d="M-10,238 C42,203 68,228 108,192 S178,167 220,137"/>
      <path d="M-10,226 C44,191 66,216 106,179 S176,154 220,124"/>
      <path d="M-10,214 C46,179 64,204 104,166 S174,141 220,111"/>
      <path d="M-10,202 C48,167 62,192 102,153 S172,128 220,98"/>
      <path d="M-10,190 C50,155 60,180 100,140 S170,115 220,85"/>
